<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<DeliverEvent>
	<!--The Header describes the message itself rather than the freight it carries. It is identical across all Närkefrakt message types-->
	<Header>
	<!--Optional. Any unique string that indicates a unique message. For example a file name, a unique timestamp, or any counter of some sort-->
		<MessageId/>
	<!--Timestamps are made in ISO 8601-->
	<!--MessageTimestamp is when the message was created. Required - it is what lets us tell a delayed message from a current one-->
		<MessageTimestamp/>
	<!--Optional but preferred. Which system, customer or integration the message comes from - for example a TMS or ERP name, a customer identifier, or the name of the integration that produced it. When several senders feed the same endpoint this is what makes a message traceable back to its origin-->
		<MessageSource/>
	</Header>
	<!--EventType is always DELIVERED_TO_CONSIGNEE for this message-->
	<EventType>DELIVERED_TO_CONSIGNEE</EventType>
	<!--Timestamps are made in ISO 8601-->
	<!--EventTimestamp is the event, in this case the delivery, actually happened. These can be different for a number of reasons, for example bad connectivity from the drivers handheld device-->
	<EventTimestamp/>
	<EventLocation>
		<Name/>
	<!--StreetNumber can be included in streetname if it's not seperated in your data-->
		<StreetName/>
		<StreetNumber/>
		<PostCode/>
		<City/>
		<Latitude/>
		<Longitude/>
	</EventLocation>
	<References>
	<!--An attribute can be used to describe what type of reference, for example type="ConsignmentNumber" or type="CustomerReference" - The attribute can be called whatever-->
	<!--Reference tags can be repeated for multiple reference-->
	<Reference/>
	</References>
	<DeliverySignature>SIGNATURE NAME</DeliverySignature>
	<DeliveryGraphicSignature>BASE64_ENCODED_FILE</DeliveryGraphicSignature>
	<Attachments>
	<!--Attachment tag can be repeated if you're sending more than 1 file-->
	<Attachment>BASE64_ENCODED_FILE</Attachment>
	<!--Optionally, attachment can have an attribute (of any name) to specify what the attachment is-->
	</Attachments>
</DeliverEvent>